<UserControl x:Class="Raf.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,4,14,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,12,14">
            <TextBlock Text="Geçmiş" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                       Text="Raf'ın taşıdığı her şey burada yazar. Geri aldığın öğe eski yerine döner ve Raf ona bir daha kendiliğinden dokunmaz."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,9,8,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Tip}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12.5" Margin="12,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                <Button Grid.Column="2" Content="Geri al" Style="{StaticResource BtnLink}" HorizontalAlignment="Right"
                                        Tag="{Binding}" Click="Undo_Click" Visibility="{Binding UndoVisibility}"/>
                                <TextBlock Grid.Column="2" Text="geri alındı" FontSize="12.5" Margin="0,0,10,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Visibility="{Binding UndoneVisibility}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Grid.Row="1" Style="{StaticResource Sub}" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                   Text="Henüz bir şey taşınmadı. Gelen klasörüne ilk dosyanı kaydettiğinde burada görünecek."/>
    </Grid>
</UserControl>
