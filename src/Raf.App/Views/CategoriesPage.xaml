<UserControl x:Class="Raf.App.Views.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,4,14,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,12,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" VerticalAlignment="Top" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                    <TextBlock Text="Yeni kategori" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Kategoriler ve kurallar" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,24,0"
                           Text="Gelen her dosya bu listedeki sırayla denenir ve uyduğu ilk kategoriye gider; önce denenmesini istediğini yukarı taşı. Alt kategoriler, bağlı oldukları kategoriden önce denenir."/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows" Margin="0,0,12,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,9,8,9" Margin="{Binding RowMargin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Order}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="17"
                                           Foreground="{Binding Dot}"/>
                                <StackPanel Grid.Column="2" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="12.5" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="AddChild_Click"
                                            Visibility="{Binding AddChildVisibility}" ToolTip="Bu kategorinin altına alt kategori ekle">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="Up_Click"
                                            IsEnabled="{Binding CanUp}" Visibility="{Binding MoveVisibility}" ToolTip="Yukarı taşı: daha önce denensin">
                                        <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="Down_Click"
                                            IsEnabled="{Binding CanDown}" Visibility="{Binding MoveVisibility}" ToolTip="Aşağı taşı: daha sonra denensin">
                                        <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="Edit_Click" ToolTip="Düzenle">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="14"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="Delete_Click"
                                            Visibility="{Binding MoveVisibility}" ToolTip="Kategoriyi sil (içindekiler silinmez)">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dene: bu dosya nereye gider?" Style="{StaticResource H2}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TestBox" Style="{StaticResource Input}" Tag="örnek: rapor.pdf" TextChanged="TestBox_TextChanged"/>
                        <StackPanel x:Name="TestResult" Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="TestIcon" Style="{StaticResource Icon}" Margin="12,0,8,0"/>
                            <TextBlock x:Name="TestName" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Content="Kuralları mevcut dosyalara uygula" Click="Reapply_Click"
                        ToolTip="Kuralları sonradan değiştirdiysen, Raf'ta zaten duran dosyaları yeni kurallara göre yeniden yerleştirir. Elle taşıdıklarına dokunmaz."/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
