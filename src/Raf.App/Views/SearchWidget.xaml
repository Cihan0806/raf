<Window x:Class="Raf.App.Views.SearchWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raf arama kutucuğu" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <!-- Kenardaki boşluk gölgeye yer açar. Değerler SearchWidget.xaml.cs içindeki sabitlerle aynı olmalı. -->
    <Grid Margin="12,8,12,16">
        <Border CornerRadius="21" Background="{DynamicResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Pill" Width="208" Height="42" CornerRadius="21" Cursor="Hand"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ToolTip="Tıkla: ara   ·   Sürükle: taşı   ·   Sağ tık: seçenekler" ToolTipService.InitialShowDelay="900"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown" MouseMove="Pill_MouseMove"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp" MouseRightButtonUp="Pill_MouseRightButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="Uygulama ara" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
