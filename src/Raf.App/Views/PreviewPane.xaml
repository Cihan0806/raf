<UserControl x:Class="Raf.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <TextBlock x:Name="Empty" Style="{StaticResource Sub}" TextAlignment="Center" Margin="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Bir öğe seç; önizlemesi burada görünür."/>

            <ScrollViewer x:Name="Details" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,18">
                    <Border Height="190" CornerRadius="10" Background="{DynamicResource Surface2Brush}">
                        <Image x:Name="Picture" Margin="10" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock x:Name="NameText" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="KindText" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,3,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Aç" Style="{StaticResource BtnPrimary}" Padding="16,6" Click="Open_Click"/>
                        <Button Content="Konumunu göster" Style="{StaticResource Btn}" Padding="12,6" Margin="8,0,0,0" Click="Reveal_Click"/>
                    </StackPanel>

                    <TextBlock Text="Kategori" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CategoryIcon" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CategoryText" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="Eklenme" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="DateText"/>

                    <TextBlock Text="Konum" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="PathText" TextWrapping="Wrap" FontSize="12.5"/>

                    <StackPanel x:Name="SnippetPanel" Visibility="Collapsed">
                        <TextBlock Text="Aramanın geçtiği yer" Style="{StaticResource Label}"/>
                        <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource SelectedBrush}">
                            <TextBlock x:Name="SnippetText" TextWrapping="Wrap" FontSize="12.5"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                        <TextBlock Text="İçinden" Style="{StaticResource Label}"/>
                        <Border CornerRadius="8" Padding="10,8" Background="{DynamicResource Surface2Brush}">
                            <TextBlock x:Name="TextPreview" TextWrapping="Wrap" FontSize="11.5"
                                       FontFamily="Cascadia Mono, Consolas"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
