<local:ChromeWindow x:Class="Raf.App.Views.MessageDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Raf.App"
                    Title="Raf" Width="470" SizeToContent="Height" ResizeMode="NoResize"
                    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,24,24,20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <TextBlock x:Name="BodyText" Style="{StaticResource Sub}"/>
        </ScrollViewer>
        <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </StackPanel>
</local:ChromeWindow>
