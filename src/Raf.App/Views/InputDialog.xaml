<local:ChromeWindow x:Class="Raf.App.Views.InputDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Raf.App"
                    Title="Raf" Width="450" SizeToContent="Height" ResizeMode="NoResize"
                    ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,24,24,20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBox x:Name="Box" Style="{StaticResource Input}" Margin="0,14,0,0" MaxLength="200"/>
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource DangerBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Vazgeç" Style="{StaticResource Btn}" IsCancel="True" MinWidth="84"/>
            <Button x:Name="OkButton" Style="{StaticResource BtnPrimary}" IsDefault="True" MinWidth="84"
                    Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</local:ChromeWindow>
